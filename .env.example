AIRFLOW_UID=1000
AIRFLOW_FERNET_KEY=            # generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_JWT_SECRET=            # generate: openssl rand -hex 32
AIRFLOW_API_SECRET_KEY=        # generate: openssl rand -hex 32
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=

GMAIL_APP_PASSWORD=

# item_factor_est (csfloat_ingest DAG)
IFE_CSFLOAT_API_KEY=
IFE_CH_HOST=clickhouse_csfloat_ingest_host
IFE_CH_PORT=8123
IFE_CH_DB=default
IFE_SKINS_FILE_KEY=batch_{N}_skins.yaml
IFE_CLICKHOUSE_USER=default
IFE_CLICKHOUSE_PASSWORD=

# price_dynamics (report_price_changes DAG)
PD_STEAM_INVENTORY_SECRET=
PD_CSFLOAT_API_KEY=
PD_RECIPIENTS_EMAIL=
PD_PRICE_CHANGE_THRESHOLD_PCT=15
PD_COMPARISON_WINDOWS_DAYS='[1, 3, 7, 14, 30]'
PD_CLICKHOUSE_HOST=clickhouse_report_price_changes_host
PD_CLICKHOUSE_PORT=8123
PD_CLICKHOUSE_USER=default
PD_CLICKHOUSE_PASSWORD=
PD_STICKER_SP_TABLE=
PD_CHARM_RETENTION=1.0

# cs2_digest (cs2_digest DAG). Reached over cs2_digest_net/audio_analytics_net,
# not host ports. CS2D_CLICKHOUSE_HOST is the *container* name, not the
# compose service name ("clickhouse") -- that alias collides with
# audio_analytics' own clickhouse (used for Langfuse traces) on the shared
# audio_analytics_net, and that one wins resolution.
CS2D_CLICKHOUSE_HOST=cs2_digest-clickhouse-1
CS2D_CLICKHOUSE_PORT=8123
CS2D_CLICKHOUSE_USER=cs2_digest
CS2D_CLICKHOUSE_PASSWORD=
CS2D_LLM_BASE_URL=http://litellm:4000
CS2D_LLM_MODEL=local-llm
CS2D_LLM_API_KEY=
CS2D_RECIPIENT_EMAIL=
